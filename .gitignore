# Camera originals. 23GB, and git is the wrong tool for them — they are irreplaceable but they
# never change, so they need a BACKUP, not version history. Keep them off the index deliberately.
#
# NOTE THE PATTERN: `src/*` and not `src/`. Git cannot re-include anything beneath an excluded
# DIRECTORY, so `src/` would also swallow the .gitkeep markers that exist to make these folders
# survive a clone — the pipeline writes into them and would otherwise fail on a fresh checkout.
# Exclude the contents, keep the directory, re-admit the marker.
src/*
!src/.gitkeep

# Everything a render wrote. Reconstructible from src/ + scripts/, and measured in gigabytes.
dist/*
!dist/*/
dist/*/*
!dist/*/.gitkeep

# Generated LUTs from the search that found the shipped one. The parameters that produce them are
# recorded in scripts/02-grade.sh's header, so the files themselves are reproducible output.
luts/tone/variants/
luts/filmic/*.cube

# Apple's LUT archive — redistributable only via Apple's own download (see luts/apple/SOURCE.txt).
luts/apple/*.zip

.DS_Store
*.partial

# Belt-and-braces: no video or camera-raw file ever belongs in this repo, wherever it lands.
# GitHub rejects files over 100MB outright and warns over 50MB; a single clip here is 0.4-2GB.
*.mov
*.mp4
*.m4v
*.avi
*.mkv
*.braw
*.r3d

# Stabilisation transforms — multi-MB per clip, regenerated by scripts/00-stabilise-detect.sh
*.trf

# Apple's conversion LUTs are NOT redistributable. They come from Apple's developer downloads
# under the Apple Developer Agreement, and this repo is public — committing them would be
# redistribution. Anyone can fetch them in two minutes with a free Apple ID; luts/apple/SOURCE.txt
# says exactly how, and the pipeline fails with that pointer if they are missing.
luts/apple/*.cube
luts/apple/*.zip

# Backup copies of generated LUTs — regenerate from the parameters in scripts/02-grade.sh.
*.cube.prev
.workdir
